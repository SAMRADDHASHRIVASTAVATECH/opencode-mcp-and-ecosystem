{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "personal_desktop_person": {
      "type": "local",
      "command": ["ABSOLUTE_PATH/PersonalDesktopPerson/.venv/bin/python", "-m", "personal_desktop_person"],
      "environment": {"PDP_CONFIG": "ABSOLUTE_PATH/PersonalDesktopPerson/config/default.json"},
      "enabled": true,
      "timeout": 30000
    },
    "open_computer_use": {
      "type": "local",
      "command": ["open-computer-use", "mcp"],
      "enabled": false,
      "timeout": 30000
    }
  },
  "instructions": ["ABSOLUTE_PATH/PersonalDesktopPerson/skills/SKILL.md"]
}
