# ---- Unified Operator configuration ---------------------------------
# Copy to .env (never commit secrets). All values optional; unset -> safe
# mock/offline behaviour where applicable.

# Offline deterministic mode (1 = never contact a live service).
UNIFIED_OFFLINE=0
# Persistent state (SQLite) + logs location. Default ~/.unified-operator
#UNIFIED_STATE_DIR=
#UNIFIED_LOG_DIR=
UNIFIED_TZ=Asia/Calcutta
UNIFIED_ALLOW_CONCURRENT_CALLS=true
UNIFIED_CALL_MAX_ATTEMPTS=3
UNIFIED_CALL_RETRY_DELAY_S=300

# ---- Permission defaults (automatic | confirmation_required | blocked) ---
UNIFIED_PERM_DEFAULT=automatic
# comma list: "action:policy", e.g. "google.gmail.send:confirmation_required,voice.call:confirmation_required"
#UNIFIED_PERM_CONFIRM=
#UNIFIED_PERM_BLOCKED=

# ---- Google Workspace ----------------------------------------------
# Preferred: service account JSON. GOOGLE_APPLICATION_CREDENTIALS is the
# standard path env; GOOGLE_CREDS_FILE is the local name we read.
#GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json
#GOOGLE_CREDS_FILE=/path/to/sa.json
# Default identity / account label.
#GOOGLE_ACCOUNT=work
# OAuth (Desktop) alternative:
#GOOGLE_CLIENT_SECRETS=/path/to/client_secret.json
#GOOGLE_TOKEN_PATH=/path/to/token.json
#GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.modify,https://www.googleapis.com/auth/calendar,https://www.googleapis.com/auth/drive,https://www.googleapis.com/auth/documents,https://www.googleapis.com/auth/spreadsheets,https://www.googleapis.com/auth/tasks,https://www.googleapis.com/auth/contacts

# ---- Discord -------------------------------------------------------
#DISCORD_TOKEN=
#DISCORD_ACCOUNT=main

# ---- Voice / telephony (real calling contract) ----------------------
# Provider must speak: POST {VOICE_API_URL}/call {action, call_id, to,...} -> JSON.
#VOICE_PROVIDER=generic
#VOICE_API_URL=https://voice.example.com
#VOICE_API_KEY=
#VOICE_AGENT_ID=business-number
#VOICE_DEFAULT_PHONE=

# ---- OpenClaw --------------------------------------------------------
# Prefer PATH discovery; override the binary / gateway if needed.
#OPENCLAW_BIN=/path/to/openclaw
#OPENCLAW_GATEWAY_URL=http://127.0.0.1
#OPENCLAW_GATEWAY_PORT=18789
#OPENCLAW_GATEWAY_TOKEN=
