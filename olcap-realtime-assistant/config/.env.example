# OLCAP realtime assistant - environment. Secrets are NOT in code.
# Copy to .env (never commit). All optional; unset = conservative defaults.

# State / storage
OLCAP_STATE_DIR=~/.olcap-realtime
OLCAP_DEFAULT_MODE=off

# --- Audio (Windows sounddevice) ---
OLCAP_AUDIO_SAMPLE_RATE=16000
OLCAP_AUDIO_CHANNELS=1
#OLCAP_AUDIO_DEVICE_ID=-1

# --- Screen (mss; Windows) ---
OLCAP_SCREEN_MONITORING=false
OLCAP_SCREEN_ACTIVE_WINDOW_ONLY=true
OLCAP_SCREEN_CAPTURE_INTERVAL_S=2.0
OLCAP_SCREEN_CLOUD_VISION=false
OLCAP_SCREEN_RECORD=false
# comma-separated app names to ignore
OLCAP_SCREEN_IGNORE_APPS=password_manager,banking_app

# --- STT (Faster-Whisper, local-first) ---
OLCAP_STT_PROVIDER=faster_whisper
OLCAP_STT_MODEL=small
OLCAP_STT_DEVICE=auto
OLCAP_STT_LANGUAGE=            # empty = auto-detect

# --- Reasoning (LM Studio / OpenAI-compatible local) ---
OLCAP_REASONING_PROVIDER=lmstudio
LM_STUDIO_ENDPOINT=http://127.0.0.1:1234/v1
#OLCAP_REASONING_MODEL=
#OLCAP_REASONING_FALLBACKS=     # comma list, e.g. openclaw
# Optional cloud fallback (only used if privacy.cloud_processing=true):
#OLCAP_CLOUD_ENDPOINT=
#OLCAP_CLOUD_API_KEY=
#OLCAP_CLOUD_MODEL=

# --- TTS (local Kokoro/Piper) ---
OLCAP_TTS_PROVIDER=none          # none | local
#OLCAP_TTS_CMD=/path/to/kokoro

# --- Privacy / security ---
OLCAP_STORE_TRANSCRIPTS=true
OLCAP_STORE_SUMMARIES=true
OLCAP_RECORD_SCREENSHOTS=false
OLCAP_CLOUD_PROCESSING=false     # master gate for any cloud processing
OLCAP_REMOTE_ACCESS=false
#OLCAP_MCP_TOKEN=                # required when OLCAP_REMOTE_ACCESS=true

# --- OpenClaw / OpenCode integration (additive, never overwrite) ---
OLCAP_OPENCLAW_ENABLED=true
OLCAP_OPENCODE_MCP_NAME=olcap-realtime-assistant-mcp
