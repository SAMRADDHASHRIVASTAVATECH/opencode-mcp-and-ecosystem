# OLCAP control-plane environment. Secrets are NEVER in code or committed.
# All values optional. Unset values fall back to safe defaults.

# Backend: simulated | android_bridge
OLCAP_BACKEND=simulated

# Device name / identity
OLCAP_DEVICE_NAME=OLCAP Phone
OLCAP_STATE_DIR=~/.olcap

# MCP / security (remote access requires a token)
OLCAP_MCP_ENABLED=true
OLCAP_REMOTE_ACCESS=false
#OLCAP_MCP_TOKEN=            # required when OLCAP_REMOTE_ACCESS=true

# Autonomy defaults (kept OFF; enabling requires explicit policy)
OLCAP_AI_CALLS_ENABLED=false
OLCAP_AUTO_ANSWER_ENABLED=false
OLCAP_VOICE_PROVIDER=simulated     # simulated | openclaw | provider | local | none
OLCAP_DEFAULT_SIM=system           # system | SIM1 | SIM2
OLCAP_MAX_CALL_DURATION=900
OLCAP_RECORD_CALLS=false
OLCAP_STORE_TRANSCRIPTS=true

# Caller / destination allowlists & denylists (E.164, comma separated)
#OLCAP_DEST_ALLOW=
#OLCAP_DEST_DENY=
#OLCAP_CALLER_ALLOW=
#OLCAP_CALLER_DENY=

# Android bridge (when OLCAP_BACKEND=android_bridge): URL of the phone's bridge
# endpoint the control-plane connects to. Kept blank so absent = NotConfigured.
#OLCAP_ANDROID_BRIDGE_URL=ws://<phone>:<port>/olcap

# Real voice provider secrets (referenced here, redacted from any output)
#OLCAP_VOICE_API_URL=
#OLCAP_VOICE_API_KEY=
#OLCAP_OPENCLAW_VOICE=
