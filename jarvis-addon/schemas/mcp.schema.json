{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MCP extension definition",
  "type": "object",
  "required": [
    "mcp_id",
    "name",
    "version",
    "description",
    "capabilities",
    "tools",
    "resources",
    "schemas",
    "permissions",
    "health_checks",
    "dependencies"
  ],
  "properties": {
    "mcp_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schemas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permissions": {
      "type": "object"
    },
    "health_checks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}