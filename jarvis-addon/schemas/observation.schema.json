{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Unified observation",
  "type": "object",
  "required": [
    "observation_id",
    "modality",
    "content",
    "source",
    "timestamp",
    "confidence",
    "verification"
  ],
  "properties": {
    "observation_id": {
      "type": "string"
    },
    "modality": {
      "type": "string",
      "enum": [
        "text",
        "voice",
        "image",
        "screenshot",
        "video",
        "audio",
        "document",
        "application_state",
        "filesystem_state",
        "browser_state",
        "api_state"
      ]
    },
    "content": {
      "type": "object"
    },
    "source": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "confidence": {
      "type": "number"
    },
    "verification": {
      "type": "object"
    },
    "entity_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}