{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Verification contract",
  "type": "object",
  "required": [
    "expected_state",
    "observed_state",
    "method",
    "result",
    "evidence",
    "confidence",
    "timestamp"
  ],
  "properties": {
    "expected_state": {
      "type": "object"
    },
    "observed_state": {
      "type": "object"
    },
    "method": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "partial"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "timestamp": {
      "type": "string"
    }
  }
}