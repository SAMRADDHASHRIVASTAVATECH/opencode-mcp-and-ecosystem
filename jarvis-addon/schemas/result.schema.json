{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Universal result",
  "type": "object",
  "required": [
    "status",
    "result",
    "artifacts",
    "verification",
    "evidence",
    "warnings",
    "errors",
    "timestamp"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed",
        "blocked"
      ]
    },
    "result": {
      "type": "object"
    },
    "artifacts": {
      "type": "array"
    },
    "verification": {
      "type": "object"
    },
    "evidence": {
      "type": "array"
    },
    "warnings": {
      "type": "array"
    },
    "errors": {
      "type": "array"
    },
    "next_action": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp": {
      "type": "string"
    }
  }
}