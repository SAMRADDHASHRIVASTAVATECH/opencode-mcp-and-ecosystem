{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shared definitions",
  "definitions": {
    "auth_level": {
      "type": "string",
      "enum": ["OBSERVE","RECOMMEND","SAFE_EXECUTE","AUTHORIZED_AUTONOMOUS","EXPLICIT_APPROVAL","DENIED"]
    },
    "policy_action": {
      "type": "string",
      "enum": ["ALLOW","ALLOW_WITH_CONDITIONS","REQUIRE_APPROVAL","DENY","ESCALATE"]
    },
    "permissions": {
      "type": "object",
      "required": ["auth_level"],
      "properties": {
        "auth_level": {"$ref":"#/definitions/auth_level"},
        "operations": {"type":"array","items":{"type":"string"}},
        "scopes": {"type":"array","items":{"type":"string"}}
      }
    },
    "versioned": {
      "type": "object",
      "required": ["id","version"],
      "properties": {
        "id": {"type":"string"},
        "version": {"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "compatible_with": {"type":"array","items":{"type":"string"}},
        "changelog": {"type":"array","items":{"type":"string"}}
      }
    }
  }
}
