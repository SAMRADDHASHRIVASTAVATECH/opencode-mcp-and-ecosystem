{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "World model entity/relationship",
  "type": "object",
  "required": [
    "entities",
    "relationships",
    "state",
    "sources"
  ],
  "properties": {
    "entities": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "state": {
      "type": "object"
    },
    "history": {
      "type": "array"
    },
    "sources": {
      "type": "array"
    },
    "confidence": {
      "type": "number"
    }
  }
}