{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "n8n-full-mcp": {
        "type": "local",
        "command": ["node", "/absolute/path/n8n-full-mcp/lib/index.js"],
        "disabled": false,
        "timeout": { "catalog": 30000, "execution": 300000 },
        "environment": {
          "N8N_MODE": "online",
          "N8N_BASE_URL": "https://n8n.example.com",
          "N8N_API_KEY": "{env:N8N_API_KEY}",
          "N8N_OFFICIAL_MCP_URL": "https://n8n.example.com/mcp-server/http",
          "N8N_MCP_TOKEN": "{env:N8N_MCP_TOKEN}"
        }
      }
    }
  }
}
