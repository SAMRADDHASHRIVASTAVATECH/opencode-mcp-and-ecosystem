# Explicitly choose online, local, or offline. Never silently switch modes.
N8N_MODE=offline
N8N_OFFLINE_DIR=./n8n-artifacts
# ONLINE/LOCAL REST adapter:
# N8N_BASE_URL=https://n8n.example.com
# N8N_API_KEY=store-in-secret-manager-not-this-file
# Official instance-level MCP (preferred when configured):
# N8N_OFFICIAL_MCP_URL=https://n8n.example.com/mcp-server/http
# N8N_MCP_TOKEN=store-in-secret-manager-not-this-file
# Only for a localhost HTTP n8n instance:
# N8N_ALLOW_INSECURE_LOCALHOST=true
N8N_TIMEOUT_MS=30000
N8N_APPROVAL_TTL_MS=60000
